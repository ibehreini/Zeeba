# Copy to .env (same folder). .env is gitignored.
# Same values as EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_KEY in the app's .env.local
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Your Zeeba login. The script signs in as you, so items land in a closet you belong to.
ZEEBA_EMAIL=you@example.com
ZEEBA_PASSWORD=
# https://console.anthropic.com/ -> API keys
ANTHROPIC_API_KEY=sk-ant-...
